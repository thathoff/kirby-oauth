{
    "name": "thathoff/kirby-oauth",
    "description": "Kirby OAuth 2 Plugin",
    "homepage": "https://github.com/thathoff/kirby-oauth",
    "type": "kirby-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Markus Denhoff",
            "email": "markus@denhoff.com"
        },
        {
            "name": "reinorange GmbH",
            "email": "info@reinorange.com",
            "homepage": "https://reinorange.com"
        }
    ],
    "require": {
        "getkirby/composer-installer": "^1.1",
        "league/oauth2-client": "^2.4"
    },
    "require-dev": {
        "getkirby/cms": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse"
    },
    "extra": {
        "installer-name": "oauth",
        "kirby-cms-path": false
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
